# Documentation sample only. Export these variables in your shell if needed.
# Local mode requires no secrets or cloud calls. This file is not loaded automatically.
APP_MODE=local-mock
LOCAL_TENANT_ID=demo
STAFF_MATCHING_DB=data/staff-matching.sqlite3

# Azure uses APP_MODE=azure-poc and the environment in infra/workloads.bicep.
# PG credentials must come from Key Vault secret references.
# Never place real passwords in this example or in the container image.
# POC_AUTH_MODE=accounts
# POC_AUTH_ORIGIN=https://your-stable-application-hostname
# POC_AUTH_RP_ID defaults to the exact hostname of POC_AUTH_ORIGIN.
# Account bootstrap/recovery credentials are setup-only, never Web runtime variables.
# The legacy POC_AUTH_MODE=basic requires POC_AUTH_USERNAME and POC_AUTH_PASSWORD.
# production is rejected; the password/passkey provider is explicitly PoC-only.
# SAAS_ENABLED=true requires azure-poc, accounts, and the additive SaaS migration.
# SAAS_DEMO_SIMULATION=true additionally requires explicit per-user/tenant grants.
# Worker uses PGUSER=staff_worker with its own private Key Vault secret.
# POC_WORKER_DB_PASSWORD is setup-only; never give it to the Web application.
